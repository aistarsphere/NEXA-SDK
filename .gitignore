.dart_tool/
.packages
build/
# root pubspec.lock is committed (single workspace lockfile)
*.iml
.idea/
.DS_Store
coverage/
**/*.g.dart.bak
.flutter-plugins
.flutter-plugins-dependencies

# example app platform build outputs
apps/nexa_example/ios/Pods/
apps/nexa_example/ios/.symlinks/
apps/nexa_example/ios/Flutter/ephemeral/
apps/nexa_example/android/.gradle/
apps/nexa_example/android/local.properties
apps/nexa_example/.flutter-plugins*

# Development secrets for the example app (--dart-define-from-file).
# Only the *.example.json template is committed.
apps/nexa_example/config/*.json
!apps/nexa_example/config/*.example.json
